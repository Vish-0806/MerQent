# Multi-stage Production Dockerfile for MerQent API
# Enforces Linux container deployment (node:20-alpine) with minimal non-root runtime

FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat openssl
WORKDIR /app
RUN npm install -g pnpm@9

FROM base AS builder
WORKDIR /app

# Copy monorepo configuration and lockfile
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json tsconfig.json ./

# Copy all package definitions so workspace dependencies resolve accurately
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/validation/package.json ./packages/validation/
COPY packages/ui/package.json ./packages/ui/
COPY packages/config/package.json ./packages/config/
COPY prisma ./prisma

RUN pnpm install --frozen-lockfile

# Copy application and shared package source files
COPY apps/api ./apps/api
COPY packages ./packages

# Build internal dependencies and API
RUN pnpm --filter @merqent/shared-types build && \
    pnpm --filter @merqent/validation build && \
    pnpm --filter @merqent/config build

ENV NODE_ENV=production

RUN pnpm --filter @merqent/api build

FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4000

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nestjs

COPY --from=builder --chown=nestjs:nodejs /app/apps/api/dist ./apps/api/dist
COPY --from=builder --chown=nestjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nestjs:nodejs /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=builder --chown=nestjs:nodejs /app/apps/api/package.json ./apps/api/package.json
COPY --from=builder --chown=nestjs:nodejs /app/packages ./packages
COPY --from=builder --chown=nestjs:nodejs /app/prisma ./prisma

USER nestjs

EXPOSE 4000

# NestJS build output generates apps/api/dist/main.js
CMD ["node", "apps/api/dist/main.js"]
