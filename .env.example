# ====================================================================
# MerQent — Environment Configuration Template
# All production secrets must be securely provisioned via KMS / Vault.
# ====================================================================

# --------------------------------------------------------------------
# General Environment
# --------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000/api/v1
WEB_APP_URL=http://localhost:3000

# --------------------------------------------------------------------
# Next.js Client-Side (Public — Browser Exposed)
# Only NEXT_PUBLIC_* variables may be bundled into frontend client code.
# --------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=MerQent

# --------------------------------------------------------------------
# PostgreSQL & pgvector Database
# --------------------------------------------------------------------
DATABASE_URL=postgresql://merqent_user:merqent_dev_password@localhost:5432/merqent_db?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# --------------------------------------------------------------------
# Redis (Cache, BullMQ Queues, Pub/Sub for SSE/WebSockets)
# --------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --------------------------------------------------------------------
# JWT & Authentication Security (Minimum 32 characters)
# --------------------------------------------------------------------
JWT_ACCESS_SECRET=replace_with_minimum_64_character_cryptographically_secure_random_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_minimum_64_character_cryptographically_secure_random_key
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# --------------------------------------------------------------------
# AI & LLM Providers (Strict Zero Data Retention Enterprise APIs)
# --------------------------------------------------------------------
OPENAI_API_KEY=sk-placeholder-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_COMPLETION_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=sk-ant-placeholder-anthropic-key

# --------------------------------------------------------------------
# Object Storage (AWS S3 / MinIO Local)
# --------------------------------------------------------------------
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET_NAME=merqent-secure-documents
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_SIGNED_URL_EXPIRY_SECONDS=900

# --------------------------------------------------------------------
# Transactional Email (Resend)
# --------------------------------------------------------------------
RESEND_API_KEY=re_placeholder_api_key
EMAIL_FROM_ADDRESS=MerQent Team <notifications@merqent.com>

# --------------------------------------------------------------------
# Observability & Monitoring
# --------------------------------------------------------------------
LOG_LEVEL=debug
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --------------------------------------------------------------------
# Local Docker Infrastructure Ports & Credentials (Optional Overrides)
# --------------------------------------------------------------------
POSTGRES_USER=merqent_user
POSTGRES_PASSWORD=merqent_dev_password
POSTGRES_DB=merqent_db
POSTGRES_PORT=5432
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
