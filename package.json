{
  "name": "merqent-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "MerQent — Specialized Post-Merger Integration (PMI) Consultant & Operator Marketplace",
  "author": "MerQent Engineering",
  "license": "MIT",
  "packageManager": "pnpm@9.5.0",
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && node -e \"const fs = require('fs'); ['.turbo', 'coverage'].forEach(d => fs.existsSync(d) && fs.rmSync(d, { recursive: true, force: true }))\"",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "env:validate": "node --env-file=.env scripts/validate-env.js",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "test:smoke": "node tests/smoke/run-smoke-tests.js",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "audit:report": "node scripts/testing/audit-report.js",
    "test:security": "node tests/security/audit-gate.test.js && node tests/security/db-destructive-guard.test.js",
    "test:db-guard": "node tests/security/db-destructive-guard.test.js",
    "deploy:check": "node scripts/deployment/verify-deployment-readiness.js",
    "db:generate": "pnpm run prisma:generate",
    "db:migrate": "pnpm run prisma:migrate",
    "db:seed": "pnpm run prisma:seed",
    "db:reset": "node scripts/database/db-guard.js && prisma migrate reset --schema=prisma/schema.prisma",
    "docker:up": "docker compose --env-file .env -f infrastructure/docker/docker-compose.yml up -d",
    "docker:down": "docker compose --env-file .env -f infrastructure/docker/docker-compose.yml down",
    "docker:prod:build": "docker compose --env-file .env -f infrastructure/docker/docker-compose.prod.yml build",
    "docker:prod:up": "docker compose --env-file .env -f infrastructure/docker/docker-compose.prod.yml up -d",
    "docker:prod:down": "docker compose --env-file .env -f infrastructure/docker/docker-compose.prod.yml down",
    "prisma:validate": "prisma validate --schema=prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema=prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:seed": "pnpm --filter @merqent/api run prisma:seed",
    "prisma:status": "prisma migrate status --schema=prisma/schema.prisma",
    "prisma:reset": "pnpm run db:reset"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "prettier": "^3.3.3",
    "prisma": "5.22.0",
    "turbo": "^2.0.14",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@prisma/client": "5.22.0"
  },
  "pnpm": {
    "overrides": {
      "body-parser": "^1.20.8",
      "qs": "^6.16.0",
      "postcss": "^8.5.29",
      "postcss-selector-parser": "^7.1.6",
      "js-yaml": "^4.3.2",
      "multer": "^2.4.0",
      "webpack": "^5.104.0",
      "tmp": "^0.2.4",
      "next": "15.5.27",
      "glob": "^10.5.0",
      "test-exclude": "^7.0.1",
      "picomatch": "^4.0.4",
      "file-type": "^21.3.4",
      "lodash": "^4.18.1"
    }
  }
}
