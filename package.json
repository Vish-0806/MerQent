{
  "name": "merqent-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "MerQent — Specialized Post-Merger Integration (PMI) Consultant & Operator Marketplace",
  "author": "MerQent Engineering",
  "license": "MIT",
  "packageManager": "pnpm@9.5.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:e2e": "turbo run test:e2e",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm --filter @merqent/api run prisma:generate",
    "db:migrate": "pnpm --filter @merqent/api run prisma:migrate",
    "db:seed": "pnpm --filter @merqent/api run prisma:seed",
    "db:studio": "pnpm --filter @merqent/api run prisma:studio",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "prettier": "^3.3.3",
    "prisma": "5.22.0",
    "turbo": "^2.0.14",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@prisma/client": "5.22.0"
  }
}
